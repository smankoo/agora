<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Copy to ~/Library/LaunchAgents/, edit the paths, then:
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/sh.agora.server.plist
     To reload after edits, bootout then bootstrap (kickstart -k only reruns the
     cached definition and will NOT pick up plist changes). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>sh.agora.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/USERNAME/.local/agora-venv/bin/agora</string>
    <string>serve</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>AGORA_CONFIG</key><string>/Users/USERNAME/.config/agora/config.toml</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/USERNAME/.local/share/agora/server.log</string>
  <key>StandardErrorPath</key><string>/Users/USERNAME/.local/share/agora/server.log</string>
</dict>
</plist>
